{
  "$id": "https://schemas.agentictrust.io/group-node/v1.1.0/schema.json",
  "source": "https://schemas.agentictrust.io/",
  "title": "Group",
  "version": "1.1.0",
  "description": "This node describes a group of individuals or entities with a shared purpose or responsibility.",
  "type": "object",
  "properties": {
    "class": {
      "type": "string",
      "description": "High-level identifier of this node type",
      "default": "Group",
      "enum": [
        "Group",
        "Committee",
        "Council",
        "Workgroup",
        "Team"
      ]
    },
    "display-name": {
      "type": "string",
      "description": "Display name for the group (distinct from ENS path)"
    },
    "avatar": {
      "type": "string",
      "description": "A URL to an image used as an avatar or logo"
    },
    "description": {
      "type": "string",
      "description": "A description of the name"
    },
    "url": {
      "type": "string",
      "description": "URL of the group",
      "format": "uri"
    },
    "lead": {
      "type": "string",
      "description": "ENS name or address of the group leader"
    },
    "lead-title": {
      "type": "string",
      "description": "Title or role of the group leader",
      "enum": [
        "Lead Steward",
        "Chair",
        "Manager",
        "Owner"
      ]
    },
    "members-title": {
      "type": "string",
      "description": "Title or role of the group members",
      "enum": [
        "Member",
        "Steward",
        "Contributor",
        "Participant"
      ]
    }
  },
  "required": [
    "class"
  ],
  "recommended": [
    "display-name",
    "lead",
    "avatar",
    "url",
    "description"
  ]
}
