{
  "$id": "https://schemas.agentictrust.io/org-node/v1.1.0/schema.json",
  "source": "https://schemas.agentictrust.io/",
  "title": "Organization",
  "version": "1.1.0",
  "description": "A legal or organizational entity.",
  "type": "object",
  "properties": {
    "class": {
      "type": "string",
      "description": "High-level identifier of this node type",
      "default": "Organization",
      "enum": [
        "Organization",
        "Foundation",
        "OPCo"
      ]
    },
    "display-name": {
      "type": "string",
      "description": "Display name for this organization (distinct from ENS path)"
    },
    "avatar": {
      "type": "string",
      "description": "A URL to an image used as an avatar or logo"
    },
    "description": {
      "type": "string",
      "description": "A description of the name"
    },
    "url": {
      "type": "string",
      "description": "URL of the organization",
      "format": "uri"
    }
  },
  "required": [
    "class"
  ],
  "recommended": [
    "display-name",
    "avatar",
    "description",
    "url"
  ]
}
