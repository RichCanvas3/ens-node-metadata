{
  "name": "@ens-node-metadata/schemas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "publish:schema": "tsx ./scripts/publish-schema.ts",
    "publish:globals": "tsx ./scripts/publish-globals.ts",
    "ontology:generate": "tsx ./scripts/generate-ontology.ts",
    "schema:generate": "tsx ./scripts/generate-schemas.ts",
    "generate": "pnpm ontology:generate && pnpm schema:generate"
  },
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types.ts",
    "./load-schemas-node": "./src/load-schemas-node.ts",
    "./published": "./src/published.ts",
    "./registry": "./published/_registry.json",
    "./latest": "./published/_latest.json"
  },
  "dependencies": {
    "@ens-node-metadata/shared": "workspace:*",
    "n3": "^1.26.0"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "tsx": "^4.7.0",
    "viem": "2.23.15"
  }
}
